@@ -0,0 +1,83 @@
+#ifndef _BCM_BR_FDBID_H
+#define _BCM_BR_FDBID_H
+/*
+<:copyright-BRCM:2023:DUAL/GPL:standard
+
+   Copyright (c) 2023 Broadcom 
