+} NBuffPtrType_t;
+
+                                    /* 2lsbits in pointer encode NbuffType_t  */
+#define NBUFF_TYPE_MASK             0x3ul
+#define NBUFF_PTR_MASK              (~NBUFF_TYPE_MASK)
