+/* Typedef of the Global BPM hook manager */
+#undef GBPM_DECL
+#define GBPM_DECL(HOOKNAME)	gbpm_ ## HOOKNAME ## _hook_t HOOKNAME;
+
+typedef struct gbpm {
+	GBPM_BIND() /* List of BPM "BIND" hooks */
+	GBPM_USER() /* List of DRV "USER" hooks */
