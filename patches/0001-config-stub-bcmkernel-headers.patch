+#define HDRS_IPinIP     ((1<<GRE) | (1<<PLD_IPv4) | (1<<PLD_IPv6) | (1<<PLD_L2) | \
+                         (1<<HDR0_IPv4) | (1<<HDR0_IPv6) | (1<<HDR0_L2) |  \
+                         (1<<DEL_IPv4) | (1<<DEL_IPv6) | (1<<DEL_L2) | (1<<VXLAN))
+
+#define HDRS_EIPinIP    (HDRS_IPinIP | (1<<GREoESP) | (3<<GREoESP_type) | (1<<ESP) | (1<<ESPoUDP)) 
