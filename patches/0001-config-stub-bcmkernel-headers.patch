+        struct
+        {
+            uint16_t is_rx_wan :1;
+            uint16_t is_rx_ddos_q :1;
+            uint16_t is_hwf_lookup_done:1; /*hwf lookup in hwf*/
+            uint16_t is_rx_outer_ipv6 :1;
