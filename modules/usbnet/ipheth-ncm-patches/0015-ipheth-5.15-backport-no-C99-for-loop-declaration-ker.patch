From 7aad41f344fc2b103333271fb70e670a21338418 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Sun, 18 Oct 2026 22:39:47 -0700
Subject: [PATCH 15/16] ipheth: 5.15 backport: no C99 for-loop declaration
 (kernel builds with -std=gnu89)

---
 drivers/net/usb/ipheth.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/net/usb/ipheth.c b/drivers/net/usb/ipheth.c
index 6af70de..e2a7db2 100644
--- a/drivers/net/usb/ipheth.c
+++ b/drivers/net/usb/ipheth.c
@@ -235,6 +235,7 @@ static int ipheth_rcvbulk_callback_ncm(struct urb *urb)
 	u16 dg_idx, dg_len;
 	int retval = -EINVAL;
 	char *buf;
+	int dpe_i;
 
 	dev = urb->context;
 
@@ -254,7 +255,7 @@ static int ipheth_rcvbulk_callback_ncm(struct urb *urb)
 		goto rx_error;
 
 	dpe = ncm0->dpe16;
-	for (int dpe_i = 0; dpe_i < IPHETH_NDP16_MAX_DPE; ++dpe_i, ++dpe) {
+	for (dpe_i = 0; dpe_i < IPHETH_NDP16_MAX_DPE; ++dpe_i, ++dpe) {
 		dg_idx = le16_to_cpu(dpe->wDatagramIndex);
 		dg_len = le16_to_cpu(dpe->wDatagramLength);
 
-- 
